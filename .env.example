# Optional benchmark configuration. Copy to .env; the runner loads it automatically.
# Every key is optional. Without a value, each CLI uses its own default model.

# Pin the model that each agent uses for the benchmark (benchmarks/tlgf/run.py).
TLGF_BENCH_CLAUDE_MODEL=claude-opus-5
TLGF_BENCH_CODEX_MODEL=
TLGF_BENCH_AGY_MODEL=gemini-3.7-flash-high

# Optional judge models for benchmarks/judge.py.
JUDGE_CLAUDE_MODEL=
JUDGE_CODEX_MODEL=
